; Engine configuration file.
; Nin0 — projet Godot 4.7 (version officielle de développement)
; Échelle du prototype : 1 unité Godot = 10 cm réels (Nino ≈ 0,5 unité).

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Nin0"
config/description="Jeu d'exploration 3D miniature"
run/main_scene="res://scenes/levels/game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameState="*res://scripts/core/game_state.gd"
Sfx="*res://scripts/core/sfx.gd"
Music="*res://scripts/core/music.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

